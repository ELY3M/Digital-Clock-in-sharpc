<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Digital_Clock</RootNamespace>
    <AssemblyName>Digital Clock</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Upstream packages only ship .NET Framework WinForms assets, so keep referencing the committed repository copies directly. -->
    <Reference Include="CircularProgressBar">
      <HintPath>..\packages\CircularProgressBar.2.8.0.16\lib\net40\CircularProgressBar.dll</HintPath>
    </Reference>
    <Reference Include="WinFormAnimation">
      <HintPath>..\packages\WinFormAnimation.1.6.0.4\lib\net40\WinFormAnimation.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
